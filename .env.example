# Public Supabase project configuration (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional application configuration
APP_ENV=development
APP_PORT=3000
LOG_LEVEL=info

# Never add SUPABASE_SERVICE_ROLE_KEY to a browser-accessible variable.
